# Configuración local de ejemplo. No contiene credenciales reales.
# Copiá este archivo como .env y completá los valores.

# Base de datos. Por defecto SQLite; para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/portafolio
DATABASE_URL=sqlite:///./blog.db
# true para ver en consola el SQL que genera SQLAlchemy
SQL_ECHO=false

# JWT (generá un secreto con: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambiame-por-un-secreto-largo
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Subida de imágenes
MAX_UPLOAD_MB=3
